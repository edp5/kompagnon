# DATABASE Configuration
DATABASE_URL=postgres://postgres:@localhost:5432/kompagnon
TEST_DATABASE_URL=postgres://postgres:@localhost:5432/kompagnon_test

# NODE ENVIRONMENT
# development | production | test
# default: development
NODE_ENV=development

# Password hash
# Default: bcrypt
PASSWORD_HASH=10

# Token secret
# Default: secret
TOKEN_SECRET=secret


# Token expiration
# Default: 1h
TOKEN_EXPIRATION=1h

# Log
# Manage login
# Enable login
# type: boolean
# default: true
LOG_ENABLED=true

# Log level
# type: string
# values: info, debug
# default: info
LOG_LEVEL=info

# human logs
# default: false
# values: false, compact
LOG_FOR_HUMANS_FORMAT=false

# Enable debuging
# type: boolean
# default: false
DEBUG_ENABLED=false


# ---------------
# Emailing
# Enable or disable mail sending
# type: boolean
# default: false
MAILING_ENABLED=false

# Mail host
# type: string
# required if MAILING_ENABLED is true
# MAILING_HOST=

# Mail secure
# type: boolean
# default: true
MAILING_SECURE=true

# Mail port
# type: number
# default: 465 if MAILING_SECURE is true, 587 otherwise
MAILING_PORT=465

# Mail user
# type: string
# required if MAILING_ENABLED is true
# MAILING_USER=

# Mail password
# type: string
# required if MAILING_ENABLED is true
# MAILING_PASSWORD=

# MailPit
## Enable or disable mailpit
# type: boolean
# default: false
MAILING_MAILPIT_ENABLED=false

# Port of the mailpit server
# type: number
# default: 1025
MAILING_MAILPIT_PORT=1025


# ---------------
# Base url
# Base url for email links and redirection from api to web site
BASE_URL="http://localhost:5173/#/"

# ---------------
# Matching algorithm
# Toggle the call to the kompagnon-algo API (set to false to skip it in development)
# Type: boolean
# Default: false
ALGORITHM_ENABLED=false
# Base url of the kompagnon-algo API used to match journeys
ALGORITHM_API_URL="http://localhost:8000"

# Api key for the kompagnon-algo API
# Type: string
# Default: empty string
ALGORITHM_API_KEY=""
